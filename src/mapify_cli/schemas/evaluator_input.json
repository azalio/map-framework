{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Evaluator Agent Input Contract",
  "description": "JSON schema defining required inputs for evaluator agent",
  "type": "object",
  "properties": {
    "language": {
      "type": "string",
      "description": "Programming language",
      "examples": ["python", "javascript", "go", "typescript", "rust"]
    },
    "project_name": {
      "type": "string",
      "description": "Project name",
      "minLength": 1
    },
    "framework": {
      "type": "string",
      "description": "Framework/library used",
      "default": ""
    },
    "subtask_description": {
      "type": "string",
      "description": "Subtask being evaluated",
      "minLength": 10
    },
    "actor_output": {
      "type": "string",
      "description": "Actor's implementation",
      "minLength": 50
    },
    "monitor_results": {
      "type": "string",
      "description": "Monitor validation results",
      "default": ""
    },
    "predictor_analysis": {
      "type": "string",
      "description": "Predictor impact analysis",
      "default": ""
    },
    "playbook_bullets": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Relevant quality evaluation patterns",
      "default": []
    },
    "quality_dimensions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Quality dimensions to evaluate",
      "default": ["correctness", "maintainability", "performance", "security"]
    }
  },
  "required": ["language", "project_name", "subtask_description", "actor_output"],
  "additionalProperties": false
}
