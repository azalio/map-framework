{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Predictor Agent Input Contract",
  "description": "JSON schema defining required inputs for predictor agent",
  "type": "object",
  "properties": {
    "language": {
      "type": "string",
      "description": "Programming language",
      "examples": ["python", "javascript", "go", "typescript", "rust"]
    },
    "project_name": {
      "type": "string",
      "description": "Project name",
      "minLength": 1
    },
    "framework": {
      "type": "string",
      "description": "Framework/library used",
      "default": ""
    },
    "subtask_description": {
      "type": "string",
      "description": "Subtask being analyzed",
      "minLength": 10
    },
    "actor_output": {
      "type": "string",
      "description": "Actor's implementation output",
      "minLength": 50
    },
    "monitor_verdict": {
      "type": "string",
      "description": "Monitor's validation verdict",
      "enum": ["approved", "needs_revision", "rejected"],
      "default": "approved"
    },
    "playbook_bullets": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Relevant impact analysis patterns",
      "default": []
    },
    "risk_trigger": {
      "type": "string",
      "description": "Reason Predictor was called",
      "default": ""
    }
  },
  "required": ["language", "project_name", "subtask_description", "actor_output"],
  "additionalProperties": false
}
