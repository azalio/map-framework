#!/usr/bin/env python3
"""Run/resume admitted Codex reviewers without relaying evidence through the parent LLM."""
from __future__ import annotations

[% set guard_mode = "exit" %][% include "_partials/python-version-guard.py.jinja" %]

import argparse
import fcntl
import hashlib
import json
import math
from typing import Any

import map_step_runner as runner
from codex_review_host import CodexReviewHost, HostError

[% set monitor_rubric %][% include "agents/monitor.md.jinja" %][% endset -%]
[% set predictor_rubric %][% include "agents/predictor.md.jinja" %][% endset -%]
[% set evaluator_rubric %][% include "agents/evaluator.md.jinja" %][% endset -%]
ROLE_RUBRICS = {
    "monitor": json.loads(r'''<% monitor_rubric | tojson %>'''),
    "predictor": json.loads(r'''<% predictor_rubric | tojson %>'''),
    "evaluator": json.loads(r'''<% evaluator_rubric | tojson %>'''),
}

GUIDANCE = """
The runner supplies context through the review_context dynamic tool. Call it sequentially.
Use one Code Mode call per chunk: text(await tools.review_context({})); set max_output_tokens to 65536.
Print the complete result, never summarize it or collect multiple chunks in one output.
Call review_context({}) repeatedly to receive the next required chunk. Consume each response;
its resource_id, offset, next_offset and hashes bind the exact immutable bytes. Use explicit
resource_id and offset only for a permitted optional resource or a reread. Never access paths,
shell, MCP, network, other reviewers or another environment. The runner acknowledges only
host-completed tool results. Continue in this same thread until context_ready; that tool result
is a NEW post-delivery finalization request with session_id and finalization_token. Include them
as context_receipt in the role's final JSON. Also include receipt with exactly four arrays
of strings: covered_files, skipped_files, denied_access, check_evidence. covered_files names
actual paths inspected; check_evidence uses only runner-issued check IDs, never invented
checks or result objects. Use [] for empty categories. Optional context need not be read for coverage.
A context_request text reply is unnecessary: use review_context. Do not stop after requesting
or receiving a chunk. After required context is ready, inspect it and return the role report.
"""


def require_success(result: dict[str, Any]) -> dict[str, Any]:
    if result.get("status") == "error":
        raise HostError(str(result.get("message", result.get("reason", result))))
    return result


def compact_bundle(branch: str) -> str:
    """Share the runner's compact bundle text; source bytes arrive exactly once via resources."""
    try:
        return runner._review_compact_bundle(branch)
    except ValueError as exc:
        raise HostError(str(exc)) from exc


class Delivery:
    """ACK only exact host-completed dynamic results, with durable replay after interruption."""

    def __init__(self, branch: str, round_id: str, state: dict[str, Any]) -> None:
        self.branch, self.round_id, self.state = branch, round_id, state
        self.directory = runner._review_branch_dir(branch) / "review-context-delivery" / state["session_id"]
        self.directory.mkdir(parents=True, exist_ok=True)
        self.pending_file = self.directory / "codex-pending.json"
        self.pending: dict[str, Any] | None = None
        self.transfers = 0
        self.resize_pending = False
        self.finalization_token = ""

    def refresh(self) -> dict[str, Any]:
        self.state = require_success(runner.review_context_status(self.state["session_id"], self.round_id, branch=self.branch))
        return self.state

    def respond(self, params: dict[str, Any]) -> dict[str, Any]:
        arguments = params.get("arguments")
        if (not isinstance(arguments, dict) or set(arguments) - {"resource_id", "offset"}
                or ("offset" in arguments and (type(arguments["offset"]) is not int or arguments["offset"] < 0))
                or ("resource_id" in arguments and not isinstance(arguments["resource_id"], str))):
            raise HostError("Invalid review context request")
        state = self.refresh()
        if state["status"] == "context_ready" and not arguments.get("resource_id"):
            self.finalization_token = state["finalization_token"]
            text = json.dumps({**state, "instruction": "All required context is delivered. Finalize now with context_receipt."})
            return {"success": True, "contentItems": [{"type": "inputText", "text": text}]}
        pending = state.get("pending_chunk")
        missing = pending or (state["remaining"][0] if state["remaining"] else {})
        resource = arguments.get("resource_id") or missing.get("resource_id")
        offset = arguments.get("offset", 0 if arguments.get("resource_id") else missing.get("offset", 0))
        if pending:
            resource, offset = pending["resource_id"], pending["offset"]
        request = {"type": "context_request", "context_id": state["context_id"], "resource_id": resource, "offset": offset}
        chunk_bytes = pending["next_offset"] - pending["offset"] if pending else 65536
        if self.resize_pending:
            if chunk_bytes <= 512:
                raise HostError("Context was not returned intact even at 512 bytes")
            chunk_bytes = max(512, chunk_bytes // 2)
            self.resize_pending = False
        chunk = require_success(runner.serve_review_context(state["reviewer"], json.dumps(request), self.round_id,
                    chunk_bytes=chunk_bytes, session_id=state["session_id"], agent_id=state["agent_id"], branch=self.branch))
        text = json.dumps(chunk, ensure_ascii=True)
        self.pending = {"call_id": params["callId"], "text": text, "chunk": chunk, "host_completed": False}
        runner._write_json_file(self.pending_file, self.pending)
        return {"success": True, "contentItems": [{"type": "inputText", "text": text}]}

    def observe(self, event: dict[str, Any]) -> None:
        params = event.get("params", {})
        item = params.get("item", {})
        if params.get("threadId") != self.state["agent_id"] or not self.pending:
            return
        if event.get("method") == "item/completed" and item.get("id") == self.pending["call_id"]:
            if (item.get("type") != "dynamicToolCall" or item.get("tool") != "review_context"
                    or item.get("status") != "completed" or item.get("success") is not True
                    or item.get("contentItems") != [{"type": "inputText", "text": self.pending["text"]}]):
                raise HostError("Codex did not acknowledge the exact context result")
            self.pending["host_completed"] = True
            return
        # Code Mode can truncate or discard a nested tool's result. Its internal
        # completion alone is not proof that the exact bytes reached the model.
        if (event.get("method") != "rawResponseItem/completed"
                or item.get("type") != "custom_tool_call_output" or not self.pending["host_completed"]):
            return
        output = item.get("output", [])
        blocks = [output] if isinstance(output, str) else [block.get("text", "") for block in output if isinstance(block, dict)]
        intact = False
        for text in blocks:
            try:
                intact |= json.loads(text) == self.pending["chunk"]
            except (ValueError, TypeError):
                pass
        if not intact:
            self.resize_pending = True
            return
        self.state = require_success(runner.ack_review_context(self.state["session_id"], self.state["agent_id"],
                         self.pending["text"], self.round_id, branch=self.branch))
        self.transfers += 1
        self.pending = None
        self.pending_file.unlink(missing_ok=True)


def _review_one(host: CodexReviewHost, branch: str, row: dict[str, Any], role: str,
                entry: dict[str, Any], ordering: str, shard: str = "") -> dict[str, Any]:
    context_id = entry["context_transport"]["context_id"]
    key = f"{ordering or 'default'}:{role}"
    old_id = row.get("context_active", {}).get(runner._review_session_key(ordering or "default", role, shard))
    old = row.get("context_sessions", {}).get(old_id, {})
    if old and old.get("context_id") != context_id:
        registered = row.get("context_manifests", {}).get(old.get("context_id"), {})
        if registered.get("runner_schema") == runner.REVIEW_CONTEXT_RUNNER_SCHEMA:
            raise HostError("Reviewer context changed; resume with the original preferences and admitted context")
        # Intent: the pending round was admitted by an older runner generation whose manifests differ by
        # construction. Replace its reader with a fresh thread on the current context instead of forcing
        # an abandon that would count against the three-round cap.
        old, old_id = {}, ""
    # A shard resumes from its own capture; the merged canonical capture exists only once every shard is done.
    witness = (row.get("shard_receipts", {}).get(key, {}).get(shard, {}) if shard else row.get("receipts", {}).get(key, {}))
    path = runner._review_branch_dir(branch) / witness.get("artifact", "missing")
    if old.get("context_id") == context_id and path.is_file():
        if hashlib.sha256(path.read_bytes()).hexdigest() != witness.get("sha256"):
            raise HostError("Captured reviewer output changed; do not silently replace it")
        output = path.read_text()
        if not runner._review_delivery_problem(row, role, json.loads(output), ordering, shard):
            # Validate this reader's host proof even when other readers are unfinished.
            single = {**row, "binding": {**row["binding"], "scheduled_reviewers": [role], "review_mode": "normal"},
                      "context_active": {runner._review_session_key("default", role, shard): old_id},
                      **({"shards": [{"id": shard}]} if shard else {})}
            if runner._review_capability_verified(single, runner._review_branch_dir(branch)):
                return {"status": "success", "reviewer": role, "output": output,
                        "thread_id": old["agent_id"], "reused": True}
    # A lost/unresumable native thread is an explicit error, never silent replacement.
    identity = host.start(old.get("agent_id", "") if old.get("context_id") == context_id else "")
    state = require_success(runner.bind_review_context(role, context_id, identity, row["round_id"],
                                                      ordering=ordering, branch=branch))
    proof = host.probe(context_id)
    require_success(runner._record_codex_host_capability(state["session_id"], proof, row["round_id"], branch=branch))
    delivery = Delivery(branch, row["round_id"], state)
    host.on_tool, host.on_event = delivery.respond, delivery.observe
    message = str(entry["prompt"]).split("\n\nPARENT-SERVED IMMUTABLE REVIEW CONTEXT", 1)[0]
    message += f"\nReviewer role: {role}. Context ID: {context_id}." + GUIDANCE
    if shard:
        message += (f"\nThis is review shard {shard}: your required scope is only this shard's files "
                    "(snapshot.required_files in inventory); other shards are reviewed separately.")
    if role == "complexity_lens":
        message += "\nFor this advisory lens only, return its original plain text after requesting context_ready; no JSON envelope."
    if ordering:
        message += "\nReview sections in this order: " + json.dumps(runner.get_review_section_order("reverse-sections" if ordering == "reverse" else "default"))
    if old:
        message += "\nResume this existing review; acknowledged chunks persist. Request the remaining context."
    malformed = 0
    finalization_sent = False
    no_progress = 0
    while True:
        before = delivery.transfers
        response = host.turn(message)
        state = delivery.refresh()
        if state["status"] != "context_ready":
            no_progress = no_progress + 1 if delivery.transfers == before else 0
            if no_progress > 1:
                raise HostError("Reviewer made no context progress; resume the saved thread without replacing it")
            message = "Continue this same review. Required context remains. " + GUIDANCE
            continue
        if role == "complexity_lens":
            if response.strip() and delivery.finalization_token == state["finalization_token"]:
                path = delivery.directory / "review.txt"
                runner._write_text_file(path, response)
                return {"status": "success", "reviewer": role, "artifact": str(path)}
            if finalization_sent:
                raise HostError("Advisory lens did not finalize after completed delivery")
            finalization_sent = True
            message = "Call review_context({}) for the finalization request, then return the original plain-text lens report."
            continue
        try:
            envelope = json.loads(response)
        except ValueError:
            envelope = {}
        receipt = envelope.get("context_receipt", {}) if isinstance(envelope, dict) else {}
        if receipt != {"session_id": state["session_id"], "finalization_token": state["finalization_token"]}:
            message = ("All required context has been delivered. Finalize now; return your role JSON and "
                       "context_receipt=" + json.dumps({"session_id": state["session_id"],
                                                       "finalization_token": state["finalization_token"]}))
            if not finalization_sent and delivery.finalization_token != state["finalization_token"]:
                finalization_sent = True
                continue  # Initial post-delivery request is not a malformed-final retry.
        else:
            kind = role if role in runner.ROLE_REVIEWER_IDS else ("adversarial" if role in {"blind", "edge_case", "acceptance"} else role)
            checked = runner.detect_truncated_agent_output(response, agent_kind="review-monitor" if kind == "monitor" else kind)
            receipt_errors = runner._review_coverage_receipt_errors(envelope.get("receipt"))
            if receipt_errors:
                message = "Correct the coverage receipt (all four arrays must contain strings): " + json.dumps(receipt_errors)
            elif checked.get("truncated") is False:
                captured = runner.capture_review_output(role, response, row["round_id"], ordering=ordering,
                                                        branch=branch, shard=shard)
                if captured.get("status") == "success":
                    return {**captured, "output": response, "thread_id": identity, "chunks": delivery.transfers}
                message = "Correct the final envelope: " + json.dumps(captured)
            else:
                message = "Correct the final role JSON; do not reread delivered context: " + json.dumps(checked)
        malformed += 1
        finalization_sent = True
        if malformed > 1:
            raise HostError("Malformed final reviewer output after one retry; resume saved context")


def run(branch: str | None = None, *, timeout: float = 900, review_preferences: str | None = None) -> dict[str, Any]:
    if not math.isfinite(timeout) or timeout <= 0:
        raise HostError("timeout must be a finite positive number")
    branch = runner._sanitize_branch(branch) if branch else runner.get_branch_name()
    directory = runner._review_branch_dir(branch)
    binding = runner._review_admitted_binding(branch)
    if binding.get("provider") != "codex":
        raise HostError("Admit a Codex review before starting the Codex runner")
    with (directory / ".codex-review-driver.lock").open("a") as lock:
        try:
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise HostError("Another Codex review driver owns this admitted run") from exc
        ledger = runner._read_review_ledger(directory)
        row = ledger["convergence"]["rounds"][-1]
        if runner._review_round_terminal(row):
            raise HostError("Review round is terminal; do not dispatch new readers")
        normal = "monitor" in binding["scheduled_reviewers"]
        if not normal and review_preferences:
            raise HostError("--review-preferences is supported only for normal reviews")
        bound_preferences: str = require_success(runner._bind_codex_review_preferences(
            review_preferences, row["round_id"], branch=branch))["review_preferences"]
        bundle = compact_bundle(branch)
        shard_ids = [item["id"] for item in row.get("shards", [])] or [""]

        def build(shard: str) -> dict[str, Any]:
            return require_success(runner.build_review_prompts(branch=branch, review_bundle_text=bundle,
                                   review_preferences=bound_preferences, pack_sources=True, role_rubrics=ROLE_RUBRICS,
                                   shard=shard) if normal else
                                   runner.build_adversarial_review_prompts(branch=branch,
                                       reviewers=binding["scheduled_reviewers"], repo_context_text=bundle,
                                       pack_sources=True, shard=shard))

        # Intent: prompts and contexts are per shard, built once and reused by every ordering.
        built_by_shard = {shard: build(shard) for shard in shard_ids}
        orderings = ("default", "reverse") if binding["review_mode"] == "compare_orderings" else ("",)
        roles = list(binding["scheduled_reviewers"])
        if normal and binding["mode"] != "lightweight" and "complexity_lens" in built_by_shard[shard_ids[0]]["prompts"]:
            roles.append("complexity_lens")
        results = []
        host = CodexReviewHost(timeout=timeout)
        try:
            for ordering in orderings:
                for shard in shard_ids:
                    built = built_by_shard[shard]
                    outputs = {}
                    for role in (list(reversed(roles)) if ordering == "reverse" else roles):
                        row = runner._read_review_ledger(directory)["convergence"]["rounds"][-1]
                        print(json.dumps({"status": "reviewing", "reviewer": role, "ordering": ordering,
                                          **({"shard": shard} if shard else {})}), flush=True)
                        result = _review_one(host, branch, row, role, built["prompts"][role], ordering, shard)
                        outputs[role] = result.get("output")
                        results.append({key: value for key, value in result.items() if key != "output"}
                                       | ({"shard": shard} if shard else {}))
                        host.on_tool = host.on_event = None
                    if not normal:
                        aggregate = runner.aggregate_adversarial_findings(outputs.get("blind"), outputs.get("edge_case"),
                            outputs.get("acceptance"), {role: outputs.get(role) for role in runner.ROLE_REVIEWER_IDS})
                        require_success(runner.capture_review_output("adversarial", json.dumps(aggregate), row["round_id"],
                                                                    ordering=ordering, branch=branch, shard=shard))
            return {"status": "success", "reviewers": results}
        finally:
            host.close()


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--branch")
    parser.add_argument("--timeout", type=float, default=900)
    parser.add_argument("--review-preferences")
    args = parser.parse_args()
    try:
        result = run(args.branch, timeout=args.timeout, review_preferences=args.review_preferences)
    except (HostError, OSError, ValueError) as exc:
        print(json.dumps({"status": "error", "message": str(exc), "recovery": "Resume the same admitted round and rerun this command. Capability and incomplete gates remain enforced."}))
        raise SystemExit(1) from exc
    print(json.dumps(result, ensure_ascii=True))
