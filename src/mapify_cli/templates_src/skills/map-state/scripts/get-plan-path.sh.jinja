#!/usr/bin/env bash
#
# get-plan-path.sh - Generate branch-scoped task plan file path
#
# Description:
#   Detects current git branch and outputs path to branch-specific task plan file.
#   Sanitizes branch names for filesystem compatibility.
#   Warns and defaults to 'default' when Git cannot determine the branch.
#
# Usage:
[% if PROVIDER == "claude" %]#   PLAN_PATH=$(bash .claude/skills/map-state/scripts/get-plan-path.sh)
[% else %]#   PLAN_PATH=$(bash .agents/skills/map-state/scripts/get-plan-path.sh)
[% endif %]#
# Output:
#   .map/<sanitized_branch>/task_plan_<sanitized_branch>.md
#
# Examples:
#   Branch: feature/auth -> .map/feature-auth/task_plan_feature-auth.md
#   Branch: main         -> .map/main/task_plan_main.md
#   Not in repo          -> .map/default/task_plan_default.md

set -euo pipefail

# Reuse the installed runner's branch scope, including unborn refs and warnings.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SANITIZED_BRANCH=$(python3 "$SCRIPT_DIR/../../../../.map/scripts/map_utils.py" branch)

# Output the plan file path (nested directory convention)
echo ".map/${SANITIZED_BRANCH}/task_plan_${SANITIZED_BRANCH}.md"
