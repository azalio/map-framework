{
  "version": "1.0",
  "description": "Skill activation triggers for MAP Framework",
  "skills": {
    "map-planning": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "medium",
      "description": "File-based planning with branch-scoped task tracking",
      "promptTriggers": {
        "keywords": [
          "create plan",
          "task plan",
          "track progress",
          "planning",
          ".map directory",
          "show task status",
          "resume work"
        ],
        "intentPatterns": [
          "(create|make|start).*(plan|planning)",
          "(track|show|check).*(progress|status|tasks)",
          "(resume|continue).*(work|task|plan)",
          "\\.map.*(directory|folder|files)"
        ]
      }
    },
    "map-learn": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "low",
      "description": "Extract and persist workflow lessons to .claude/rules/learned/",
      "promptTriggers": {
        "keywords": [
          "extract lessons",
          "save patterns",
          "learn from workflow",
          "preserve learnings",
          "map-learn",
          "project memory",
          "capture gotchas"
        ],
        "intentPatterns": [
          "(extract|save|preserve|capture).*(lesson|pattern|learning|gotcha)",
          "(learn|remember).*(workflow|session|implementation)",
          "map-learn"
        ]
      }
    },
    "map-check": {
      "type": "manual",
      "enforcement": "manual",
      "priority": "high",
      "description": "Run quality gates (lint, types, tests) and verify MAP workflow completion.",
      "promptTriggers": {
        "keywords": [
          "map-check",
          "run checks",
          "quality gates",
          "verify workflow",
          "validate completion"
        ],
        "intentPatterns": [
          "map-check",
          "(run|execute).*(check|gate|lint|test)"
        ]
      }
    },
    "map-debug": {
      "type": "manual",
      "enforcement": "manual",
      "priority": "high",
      "description": "Structured MAP debugging via task-decomposer, actor, monitor agents.",
      "promptTriggers": {
        "keywords": [
          "map-debug",
          "debug bug",
          "diagnose error",
          "isolate regression",
          "reproduce bug"
        ],
        "intentPatterns": [
          "map-debug",
          "(debug|diagnose|isolate).*(bug|error|regression)"
        ]
      }
    },
    "map-efficient": {
      "type": "manual",
      "enforcement": "manual",
      "priority": "high",
      "description": "Token-efficient MAP workflow with state-machine orchestration.",
      "promptTriggers": {
        "keywords": [
          "map-efficient",
          "efficient workflow",
          "state machine",
          "full workflow",
          "run map"
        ],
        "intentPatterns": [
          "map-efficient",
          "(run|execute).*(efficient|map workflow)"
        ]
      }
    },
    "map-fast": {
      "type": "manual",
      "enforcement": "manual",
      "priority": "high",
      "description": "Minimal MAP workflow for small low-risk changes (no Predictor/Reflector).",
      "promptTriggers": {
        "keywords": [
          "map-fast",
          "fast workflow",
          "small change",
          "quick task",
          "low risk"
        ],
        "intentPatterns": [
          "map-fast",
          "(small|quick|fast).*(change|task)"
        ]
      }
    },
    "map-plan": {
      "type": "manual",
      "enforcement": "manual",
      "priority": "high",
      "description": "ARCHITECT phase: decompose a complex task into atomic subtasks.",
      "promptTriggers": {
        "keywords": [
          "map-plan",
          "decompose task",
          "task plan",
          "subtasks",
          "architect phase"
        ],
        "intentPatterns": [
          "map-plan",
          "(decompose|plan|break down).*(task|feature|work)"
        ]
      }
    },
    "map-release": {
      "type": "manual",
      "enforcement": "manual",
      "priority": "high",
      "description": "Execute mapify-cli package release workflow with validation gates.",
      "promptTriggers": {
        "keywords": [
          "map-release",
          "release workflow",
          "publish package",
          "ship release",
          "pypi release"
        ],
        "intentPatterns": [
          "map-release",
          "(ship|publish|release).*(package|version|pypi)"
        ]
      }
    },
    "map-resume": {
      "type": "manual",
      "enforcement": "manual",
      "priority": "high",
      "description": "Resume an interrupted MAP workflow from step_state.json checkpoint.",
      "promptTriggers": {
        "keywords": [
          "map-resume",
          "resume workflow",
          "continue map",
          "checkpoint recovery",
          "restart workflow"
        ],
        "intentPatterns": [
          "map-resume",
          "(resume|continue|restart).*(workflow|map|checkpoint)"
        ]
      }
    },
    "map-review": {
      "type": "manual",
      "enforcement": "manual",
      "priority": "high",
      "description": "Interactive code review using Monitor, Predictor, Evaluator agents.",
      "promptTriggers": {
        "keywords": [
          "map-review",
          "code review",
          "review changes",
          "review diff",
          "pre-merge review"
        ],
        "intentPatterns": [
          "map-review",
          "(review|audit).*(code|change|diff|pr)"
        ]
      }
    },
    "map-task": {
      "type": "manual",
      "enforcement": "manual",
      "priority": "high",
      "description": "Execute a single subtask from an existing MAP plan.",
      "promptTriggers": {
        "keywords": [
          "map-task",
          "single subtask",
          "run subtask",
          "execute subtask",
          "one task"
        ],
        "intentPatterns": [
          "map-task",
          "(run|execute).*(subtask|single task)"
        ]
      }
    },
    "map-tdd": {
      "type": "manual",
      "enforcement": "manual",
      "priority": "high",
      "description": "TDD MAP workflow: spec-driven tests written before implementation.",
      "promptTriggers": {
        "keywords": [
          "map-tdd",
          "tdd workflow",
          "test first",
          "spec driven tests",
          "test driven"
        ],
        "intentPatterns": [
          "map-tdd",
          "(test.first|tdd|spec.driven).*(workflow|develop)"
        ]
      }
    }
  }
}
