{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mapify CLI Reference",
  "version": "2.0.0",
  "description": "Machine-readable specification of mapify CLI commands, parameters, and usage patterns.",
  "commands": {
    "validate": {
      "description": "Validate task dependency graphs",
      "subcommands": {
        "graph": {
          "description": "Validate TaskDecomposer dependency graph",
          "usage": "mapify validate graph [INPUT_FILE] [OPTIONS]",
          "parameters": {
            "input_file": {
              "type": "path",
              "required": false,
              "position": "argument",
              "description": "JSON file to validate (or use stdin)"
            },
            "visualize": {
              "type": "boolean",
              "required": false,
              "flag": "--visualize",
              "default": false,
              "description": "Show ASCII dependency tree"
            },
            "no-color": {
              "type": "boolean",
              "required": false,
              "flag": "--no-color",
              "default": false,
              "description": "Disable colored output"
            },
            "format": {
              "type": "string",
              "required": false,
              "flag": "--format",
              "alias": "-f",
              "default": "json",
              "enum": ["json", "text"],
              "description": "Output format"
            },
            "strict": {
              "type": "boolean",
              "required": false,
              "flag": "--strict",
              "default": false,
              "description": "Fail on warnings (orphaned tasks), not just critical errors"
            }
          },
          "exit_codes": {
            "0": "Valid graph (no critical errors; warnings allowed unless --strict)",
            "1": "Invalid graph (critical errors found, or warnings with --strict)",
            "2": "Malformed input (invalid JSON or missing required fields)"
          },
          "examples": [
            {
              "command": "mapify validate graph task_plan.json",
              "description": "Validate graph from file"
            },
            {
              "command": "echo '{\"subtasks\":[...]}' | mapify validate graph",
              "description": "Validate graph from stdin"
            },
            {
              "command": "mapify validate graph task_plan.json --visualize",
              "description": "Validate and show dependency tree"
            },
            {
              "command": "mapify validate graph task_plan.json --strict",
              "description": "Fail on warnings as well as errors"
            }
          ]
        }
      }
    },
    "root": {
      "description": "Root-level mapify commands",
      "commands": {
        "init": {
          "description": "Initialize a new MAP Framework project",
          "usage": "mapify init [PROJECT_NAME] [OPTIONS]",
          "parameters": {
            "project_name": {
              "type": "string",
              "required": false,
              "position": "argument",
              "description": "Name for your new project directory (use '.' for current directory)"
            },
            "mcp": {
              "type": "string",
              "required": false,
              "flag": "--mcp",
              "enum": ["all", "essential", "none", "comma-separated-list"],
              "description": "MCP servers to enable"
            },
            "no-git": {
              "type": "boolean",
              "required": false,
              "flag": "--no-git",
              "default": false,
              "description": "Skip git repository initialization"
            },
            "force": {
              "type": "boolean",
              "required": false,
              "flag": "--force",
              "default": false,
              "description": "Force merge/overwrite when using '.' in non-empty directory"
            }
          },
          "examples": [
            {
              "command": "mapify init my-project",
              "description": "Create new project directory with MAP templates"
            },
            {
              "command": "mapify init . --mcp essential",
              "description": "Initialize MAP in current directory with essential MCP servers"
            },
            {
              "command": "mapify init . --force",
              "description": "Force initialization in non-empty directory"
            }
          ]
        },
        "check": {
          "description": "Quick environment check for tools, MAP initialization, bundled templates, and supported MCP servers",
          "usage": "mapify check [OPTIONS]",
          "parameters": {
            "debug": {
              "type": "boolean",
              "required": false,
              "flag": "--debug",
              "default": false,
              "description": "Enable debug logging"
            }
          },
          "examples": [
            {
              "command": "mapify check",
              "description": "Verify tool availability and MAP project readiness"
            },
            {
              "command": "mapify check --debug",
              "description": "Check with verbose debug output"
            }
          ]
        },
        "doctor": {
          "description": "Run a detailed MAP project readiness diagnosis",
          "usage": "mapify doctor [OPTIONS]",
          "parameters": {
            "debug": {
              "type": "boolean",
              "required": false,
              "flag": "--debug",
              "default": false,
              "description": "Enable debug logging"
            }
          },
          "examples": [
            {
              "command": "mapify doctor",
              "description": "Diagnose current project state"
            },
            {
              "command": "mapify doctor --debug",
              "description": "Diagnose with debug logging"
            }
          ]
        },
        "upgrade": {
          "description": "Upgrade the mapify CLI itself to the latest released version",
          "usage": "mapify upgrade",
          "parameters": {},
          "examples": [
            {
              "command": "mapify upgrade",
              "description": "Self-upgrade mapify-cli to the latest release (uv tool / pip), then run 'mapify init . --force' to refresh project files"
            }
          ]
        }
      }
    }
  },
  "common_patterns": {
    "stdin_support": {
      "description": "Commands that accept stdin input",
      "commands": [
        "mapify validate graph"
      ],
      "example": "echo '{...}' | mapify validate graph"
    }
  },
  "error_patterns": {
    "description": "Common mistakes and corrections",
    "errors": [
      {
        "category": "legacy_command",
        "mistake": "mapify playbook ...",
        "reason": "Legacy playbook CLI commands removed",
        "correction": "Use slash commands (/map-efficient, /map-learn, etc.)",
        "explanation": "Use MAP slash commands for workflow operations"
      }
    ]
  },
  "metadata": {
    "generated_from": "src/mapify_cli/__init__.py",
    "command_definitions": [
      "@app.command() decorators",
      "@validate_app.command() decorators"
    ],
    "version": "Based on map-framework 3.5.0",
    "last_updated": "2026-03-19",
    "related_docs": [
      "docs/USAGE.md",
      "docs/ARCHITECTURE.md",
      "docs/INSTALL.md"
    ]
  }
}
