@@ -0,0 +1,21 @@
+import unittest
+
+from contacts import add_contact
+
+
+class AddressBookTests(unittest.TestCase):
+    def test_add(self):
+        contacts = [("X", "home")]
+        self.assertTrue(add_contact(contacts, "Y", "work"))
+        self.assertEqual(contacts, [("X", "home"), ("Y", "work")])
+
+    def test_repeat(self):
+        contacts = [("X", "home")]
+        for _ in range(2):
+            self.assertTrue(add_contact(contacts, "X", "work"))
+            self.assertEqual(contacts, [("X", "home")])
+
+    def test_exact_repeat(self):
+        contacts = [("X", "home")]
+        self.assertTrue(add_contact(contacts, "X", "home"))
+        self.assertEqual(contacts, [("X", "home")])
