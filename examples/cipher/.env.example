# Cipher MCP Infrastructure - Environment Variables
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env file to git!

# PostgreSQL Configuration
POSTGRES_USER=cipher
# CHANGE THIS! Generate a strong password with: openssl rand -base64 24
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=cipher

# Qdrant Configuration (optional)
# Uncomment and set if you need API key authentication
# QDRANT_API_KEY=your_qdrant_api_key_here

# Security Notes:
# 1. Use strong passwords (min 16 characters, mixed case, numbers, symbols)
# 2. Never share .env file or commit it to version control
# 3. Rotate passwords regularly
# 4. Use different passwords for different environments (dev/staging/prod)

# Example strong password generation (run in terminal):
# openssl rand -base64 24
